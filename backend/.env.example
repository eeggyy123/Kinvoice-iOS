APP_NAME=KinVoice
ENVIRONMENT=development
DOCS_ENABLED=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:4173

# 可选。生产环境建议生成随机值，并同步填入 iOS Info.plist 的 APIAccessToken。
APP_ACCESS_TOKEN=

# OpenAI Chat Completions 兼容中转站
LLM_API_KEY=sk-your-key-here
LLM_API_BASE=https://your-endpoint.example/v1
LLM_MODEL=your-model-name
LLM_TIMEOUT_SECONDS=35

LOG_LEVEL=INFO
