APP_NAME=KinVoice
ENVIRONMENT=development
DOCS_ENABLED=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:4173,http://127.0.0.1:4181

# 可选。生产环境建议生成随机值，并同步填入 iOS Info.plist 的 APIAccessToken。
APP_ACCESS_TOKEN=

# cctq.ai 是 OpenAI Chat Completions 兼容中转站。
# 真实密钥只写入 backend/.env，禁止提交到 Git 或写入 Android BuildConfig。
LLM_API_KEY=sk-your-key-here
LLM_API_BASE=https://cctq.ai/v1
LLM_MODEL=your-cctq-model-id
LLM_TIMEOUT_SECONDS=35

LOG_LEVEL=INFO
